// server/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. Енумератори
enum Role {
  CLIENT
  SPECIALIST
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SessionStatus {
  CREATED
  PENDING_DONATION
  CONFIRMED
  COMPLETED
  CANCELLED
}

// НОВЕ: статус підтвердження донату
enum DonationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

// НОВЕ: типи сповіщень
enum NotificationType {
  SESSION_BOOKED
  DONATION_SUBMITTED
  DONATION_CONFIRMED
  DONATION_REJECTED
  SESSION_REMINDER
  SESSION_CANCELLED
  NEW_MESSAGE
  SPECIALIST_APPROVED
}

// 2. Моделі таблиць

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique // Унікальний ID користувача з Clerk
  email     String   @unique
  firstName String?
  lastName  String?
  role      Role     @default(CLIENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Зв'язки
  specialistProfile SpecialistProfile?
  clientSessions    Session[]           @relation("ClientSessions")
  diaryEntries      DiaryEntry[]
  screeningResults  ScreeningResult[]
  safetyPlan        SafetyPlan?

  // НОВЕ
  sentMessages      Message[]
  notifications     Notification[]
  clientReviews     Review[]
  onboardingAnswer  OnboardingAnswer?
}

model SpecialistProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio                String?
  specializations    String[]           // Теги: "КПТ", "Гештальт"
  hourlyRate         Int?               // Рекомендований донат
  verificationStatus VerificationStatus @default(PENDING)
  documentsUrl       String[]           // Посилання на дипломи/сертифікати

  fullLegalName      String?            // ПІБ як зазначено в документі про освіту
  licenseNumber      String?            // Номер диплома/сертифіката/ліцензії
  issuingInstitution String?            // Заклад, що видав документ
  graduationYear     Int?               // Рік випуску/видачі документа

  aiScreeningStatus  String?            // "MATCH" | "MISMATCH" | "UNREADABLE" | "NOT_RELEVANT"
  aiScreeningNotes   String?            @db.Text
  aiScreenedAt       DateTime?

  photoUrl           String?            // Фото профілю, показується клієнтам публічно
  experience         String?            @db.Text // Досвід роботи — вільний текст (роки/опис)

  sessions           Session[]          @relation("SpecialistSessions")

  // НОВЕ
  availabilitySlots  AvailabilitySlot[]
  reviews            Review[]
}

model Session {
  id              String            @id @default(cuid())
  clientId        String
  client          User              @relation("ClientSessions", fields: [clientId], references: [id])

  specialistId    String
  specialist      SpecialistProfile @relation("SpecialistSessions", fields: [specialistId], references: [id])

  startTime       DateTime
  endTime         DateTime
  status          SessionStatus     @default(CREATED)

  specialistNotes String?           // Приватні нотатки (E2EE шифрування)

  // НОВЕ: замість вільного donationUrl — звʼязок з конкретним фондом
  fundraiserId    String?
  fundraiser      Fundraiser?       @relation(fields: [fundraiserId], references: [id])

  // НОВЕ: слот, який заброньований під цю сесію
  slotId          String?           @unique
  slot            AvailabilitySlot? @relation(fields: [slotId], references: [id])

  // НОВЕ
  donations       Donation[]
  messages        Message[]
  review          Review?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

// НОВЕ: фонд/збір, куди можна задонатити замість оплати сесії
model Fundraiser {
  id            String     @id @default(cuid())
  name          String
  description   String?    @db.Text
  bankJarUrl    String     // Посилання на банку Monobank/іншого сервісу
  category      String?    // напр. "оборона", "гуманітарна допомога"
  logoUrl       String?
  isVerified    Boolean    @default(false)
  isActive      Boolean    @default(true)

  // ID банки в Monobank Open API (не URL, а саме id з /personal/client-info)
  // — якщо заповнено, донати на цей фонд додатково звіряються з реальною
  // випискою банки через MONOBANK_JAR_TOKEN. Необов'язкове — не всі фонди
  // мають таку інтеграцію.
  monobankJarId String?

  sessions    Session[]
  donations   Donation[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// НОВЕ: факт донату й підтвердження до нього
model Donation {
  id            String         @id @default(cuid())
  sessionId     String
  session       Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  fundraiserId  String
  fundraiser    Fundraiser     @relation(fields: [fundraiserId], references: [id])

  amount        Float?         // Сума, заявлена клієнтом (обов'язкова на рівні API — див. createDonation)
  // Скріншот-підтвердження донату. Опційний: спершу пробуємо підтвердити
  // донат автоматично через реальну виписку банки (checkBankConfirmation) —
  // скрін потрібен лише як запасний варіант, коли банк не підтвердив одразу.
  proofUrl      String?
  // SHA-256 вмісту файлу — жорсткий захист від повторного використання
  // того самого скріна для іншого донату (унікальний, але nullable —
  // щоб не ламати міграцію на існуючих рядках без хешу).
  proofHash     String?        @unique
  status        DonationStatus @default(PENDING)

  // AI-підказка (НЕ рішення) для того, хто підтверджує: що вдалось
  // розпізнати на скріні, і чи є розбіжності з заявленими даними.
  extractedAmount    Float?      // Сума, яку AI прочитав зі скріна
  extractedReference String?     // Номер транзакції/квитанції, якщо розпізнано
  extractedRecipient String?     // Одержувач/назва банки, яку AI прочитав зі скріна
  aiScreeningStatus  String?     // "OK" | "RECIPIENT_MISMATCH" | "AMOUNT_MISMATCH" | "DUPLICATE_REFERENCE" | "UNREADABLE" | "SUSPICIOUS"
  aiScreeningNotes   String?     @db.Text
  aiScreenedAt       DateTime?

  // Незалежна від AI перевірка: чи знайшовся в реальній виписці банки
  // (Monobank API) переказ, що збігається за сумою — набагато надійніший
  // сигнал за читання скріна, доступний лише коли Fundraiser.monobankJarId
  // заповнено. bankTransactionId унікальний — щоб той самий реальний
  // переказ не підтвердив два різні донати.
  bankConfirmed     Boolean    @default(false)
  bankTransactionId String?    @unique

  // Навмисно НЕ зовнішній ключ (щоб не ускладнювати каскади) —
  // просто userId того, хто підтвердив (спеціаліст або адмін)
  confirmedById String?
  confirmedAt   DateTime?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([extractedReference])
}

// НОВЕ: часові слоти, які відкриває спеціаліст для запису
model AvailabilitySlot {
  id           String            @id @default(cuid())
  specialistId String
  specialist   SpecialistProfile @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  startTime    DateTime
  endTime      DateTime
  isBooked     Boolean           @default(false)

  session      Session?

  createdAt    DateTime          @default(now())
}

// НОВЕ: чат клієнта і спеціаліста в межах сесії
model Message {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])

  content   String   @db.Text
  isRead    Boolean  @default(false)

  editedAt  DateTime?
  isDeleted Boolean  @default(false)

  createdAt DateTime @default(now())
}

// НОВЕ: сповіщення користувачу
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  title     String
  message   String?
  link      String?          // Куди веде сповіщення, напр. "/dashboard"
  isRead    Boolean          @default(false)

  createdAt DateTime         @default(now())
}

// НОВЕ: відгук клієнта на спеціаліста після завершеної сесії
model Review {
  id           String            @id @default(cuid())
  sessionId    String            @unique
  session      Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  clientId     String
  client       User              @relation(fields: [clientId], references: [id])

  specialistId String
  specialist   SpecialistProfile @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  rating       Int               // 1-5
  comment      String?           @db.Text

  createdAt    DateTime          @default(now())
}

model DiaryEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date       DateTime
  // Зашифровано на клієнті (AES-GCM), сервер зберігає лише незрозумілий блоб.
  // Містить base64(iv + ciphertext) для JSON {mood, physicalState, sleepHours, note}.
  cipherText String   @db.Text

  createdAt  DateTime @default(now())

  @@unique([userId, date])
}

// Результати скринінг-тестів (PHQ-9 / GAD-7). Той самий підхід E2EE, що й
// у DiaryEntry, і той самий локальний ключ шифрування — сервер бачить лише
// testKey (яку шкалу проходили) та дату, все інше (бали, відповіді) зашифровано.
model ScreeningResult {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  testKey    String // "phq9" | "gad7"
  date       DateTime @default(now())
  cipherText String   @db.Text

  createdAt  DateTime @default(now())
}

// "Аптечка ресурсу" (Safety Plan) — персональний список того, що повертає
// до стабільного стану: прості дії, спогади, цитати, посилання на плейлисти,
// довірені контакти. Один запис на користувача (не по днях, як щоденник),
// той самий підхід E2EE й той самий локальний ключ шифрування — сервер
// бачить лише сам факт наявності запису, увесь вміст зашифрований.
model SafetyPlan {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  cipherText String   @db.Text

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// НОВЕ: відповіді клієнта на онбординг-опитування (для smart matching)
model OnboardingAnswer {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  concerns        String[] // напр. ["тривожність", "стосунки", "вигорання"]
  preferredGender String?  // "чоловіча" / "жіноча" / "не має значення"
  urgencyLevel    String?  // "терміново" / "можу почекати"

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}