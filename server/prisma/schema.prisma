// server/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. Енумератори
enum Role {
  CLIENT
  SPECIALIST
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SessionStatus {
  CREATED
  PENDING_DONATION
  CONFIRMED
  COMPLETED
  CANCELLED
}

// 2. Моделі таблиць

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique // Унікальний ID користувача з Clerk
  email     String   @unique
  firstName String?
  lastName  String?
  role      Role     @default(CLIENT)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Зв'язки
  specialistProfile SpecialistProfile?
  clientSessions    Session[]           @relation("ClientSessions")
  diaryEntries      DiaryEntry[]
}

model SpecialistProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  bio                String?
  specializations    String[]           // Теги: "КПТ", "Гештальт"
  hourlyRate         Int?               // Рекомендований донат
  verificationStatus VerificationStatus @default(PENDING)
  documentsUrl       String[]           // Посилання на дипломи/сертифікати
  
  sessions           Session[]          @relation("SpecialistSessions")
}

model Session {
  id              String            @id @default(cuid())
  clientId        String
  client          User              @relation("ClientSessions", fields: [clientId], references: [id])
  
  specialistId    String
  specialist      SpecialistProfile @relation("SpecialistSessions", fields: [specialistId], references: [id])
  
  startTime       DateTime
  endTime         DateTime
  status          SessionStatus     @default(CREATED)
  
  donationUrl     String?           // Посилання на банку Monobank
  specialistNotes String?           // Приватні нотатки (E2EE шифрування)
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model DiaryEntry {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  moodScore       Int      // 1-10
  moodTags        String[] // ["робота", "сім'я", "тривога"]
  textContent     String?  @db.Text // Текст щоденника
  
  sleepHours      Float?
  workoutDone     Boolean  @default(false)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}