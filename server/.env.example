# Скопіюй у server/.env і заповни реальними значеннями.

# PostgreSQL (напр. Neon) — рядок підключення з ?sslmode=require
DATABASE_URL=

# Clerk (Dashboard → API Keys)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Google Gemini API — для AI-компаньйона, аналізу думки, тижневої
# рефлексії щоденника, AI-скринінгу документів спеціаліста
GEMINI_API_KEY=

# Пошта, з якої надсилаються сповіщення (якщо використовується)
EMAIL_USER=
EMAIL_PASS=

# Токен банки monobank для перевірки донатів
MONOBANK_JAR_TOKEN=

# Cloudflare R2 (S3-сумісне сховище файлів) — Dashboard → R2 Object Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public Development URL бакета (Settings → Public Development URL), без
# слеша в кінці — використовується лише для публічних файлів (фото
# спеціалістів)
R2_PUBLIC_URL=

# Origin(и) фронтенду, яким дозволено ходити в цей API — через кому,
# якщо декілька (напр. dev + прод). За замовчуванням дозволений лише
# http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Порт, на якому підіймається сервер
PORT=5000

# production — вимикає дебаг-логи при старті
NODE_ENV=development
