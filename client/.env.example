# Скопіюй у client/.env і заповни реальними значеннями.

# Clerk publishable key (Dashboard → API Keys)
VITE_CLERK_PUBLISHABLE_KEY=

# Адреса бекенду. Локально можна не задавати — за замовчуванням
# http://localhost:5000/api. При деплої вкажи справжню адресу бекенду,
# напр. https://api.opora.example.com/api
VITE_API_BASE_URL=
