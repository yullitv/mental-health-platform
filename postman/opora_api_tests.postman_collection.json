                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Повертається непорожній масив\", () => { pm.expect(list).to.be.an(\"array\"); pm.expect(list.length).to.be.above(0); });",
                  "pm.test(\"Кожна картка містить ім'я, рейтинг і кількість відгуків\", () => list.forEach(s => {",
                  "  pm.expect(s.user.firstName).to.be.a(\"string\");",
                  "  pm.expect(s).to.have.property(\"averageRating\");",
                  "  pm.expect(s.reviewsCount).to.be.a(\"number\");",
